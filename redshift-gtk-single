#!/bin/sh
# Lanza una sola instancia de Redshift. El redshift de Mint no tiene
# bloqueo propio, y dos instancias aplican rampas de color distintas
# produciendo parpadeos entre tonos cálidos.
set -eu

# Un proceso zombie también aparece en pgrep: hay que ignorarlo para no
# bloquear el arranque tras reiniciar Redshift desde la ventana de ajustes.
running=0
for state in $(ps -C redshift -o stat= 2>/dev/null); do
    case "$state" in
        Z*) ;;
        *) running=1 ;;
    esac
done
if [ "$running" -eq 1 ]; then
    exit 0
fi

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCK="$RUNDIR/redshift-gtk-$(id -u).lock"
exec 9>"$LOCK"
if ! flock -n 9; then
    exit 0
fi

exec /usr/bin/redshift-gtk "$@"
